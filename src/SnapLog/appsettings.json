{
  "Capture": {
    "MaxImageDimension": 2560,
    "SaveImages": true,
    "ImageDirectory": "",
    "ImageRetentionDays": 30,
    "ImageFormat": "Png"
  },
  "Triggers": {
    "Mode": "Both",
    "ForegroundSettleMilliseconds": 5000,
    "MinSecondsBetweenCaptures": 20,
    "IntervalSeconds": 300,
    "ExcludedProcesses": [
      "snaplog"
    ],
    "ExcludedWindowTitles": [
      "Program Manager",
      "Windows Default Lock Screen"
    ],
    "CaptureCycleMinutes": 10
  },
  "Ocr": {
    "Engine": "PaddleOcr",
    "Mode": "Realtime",
    "BatchTimeOfDay": "02:00",
    "TargetLongestSide": 2400,
    "MaxUpscale": 3.0,
    "MinTextLength": 4,
    "DropEmptyRecords": true,
    "PaddleModel": "V6Tiny",
    "PaddleThreads": 4,
    "PaddleEnableMkldnn": false,
    "PaddleMaxSideLength": 2048
  },
  "Storage": {
    "DataDirectory": "",
    "DatabaseFileName": "activity.db",
    "ImportLegacyCsv": true,
    "RecordRetentionDays": 0
  },
  "Summarization": {
    "Enabled": false,
    "ConsentGranted": false,
    "Providers": [
      {
        "Name": "主模型",
        "Enabled": true,
        "Endpoint": "https://api.openai.com/v1",
        "Model": "gpt-4o-mini",
        "ApiKey": "",
        "ApiKeyEnvironmentVariable": "SNAPLOG_OPENAI_API_KEY"
      }
    ],
    "PayloadMode": "TextOnly",
    "MaxImages": 6,
    "ImageSampleSeconds": 300,
    "ImageDetail": "Auto",
    "MaxInputCharacters": 24000,
    "MaxRecords": 200,
    "Language": "zh-CN",
    "ExtraInstructions": "",
    "RetryCount": 2,
    "RetryDelaySeconds": 3,
    "RequestTimeoutSeconds": 120,
    "ScheduleEnabled": false,
    "ScheduleTimeOfDay": "18:30",
    "SystemPromptOverride": "",
    "WorkProjects": []
  },
  "Logging": {
    "Enabled": true,
    "Level": "Info",
    "RetentionDays": 7
  },
  "Ui": {
    "StartMinimizedToTray": true,
    "CloseToTrayInsteadOfExit": true
  },
  "Feishu": {
    "Enabled": false,
    "ScheduleTimeOfDay": "19:00",
    "PushAfterSummary": false,
    "AppId": "",
    "AppSecret": "",
    "AppSecretEnvironmentVariable": "SNAPLOG_FEISHU_APP_SECRET",
    "AuthMode": "TenantAccessToken",
    "AppToken": "",
    "TableId": "",
    "FieldMappings": [
      {
        "RecordField": "StartedAt",
        "FeishuField": "时间"
      },
      {
        "RecordField": "Trigger",
        "FeishuField": "触发来源"
      },
      {
        "RecordField": "Provider",
        "FeishuField": "模型"
      },
      {
        "RecordField": "RecordCount",
        "FeishuField": "记录条数"
      },
      {
        "RecordField": "Markdown",
        "FeishuField": "小结"
      }
    ],
    "PushLookbackDays": 1,
    "MaxTextLength": 2000,
    "BatchSize": 200
  }
}
