<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    2.0 的调色板。放在 Application.Resources 里而不是 Styles 里：
    这样任何窗口、任何控件在整个应用范围内都能用 StaticResource 取到，
    也不用在每个构造函数里 FindResource。
  -->
  <SolidColorBrush x:Key="Accent" Color="#2563EB" />
  <SolidColorBrush x:Key="AccentSoft" Color="#EFF4FF" />
  <SolidColorBrush x:Key="Ink" Color="#111827" />
  <SolidColorBrush x:Key="Ink2" Color="#4B5563" />
  <!-- 承载信息的灰字（"待补跑""共 145 条""备用模型"这类）：#9CA3AF 在白底上只有 2.5:1，
       读不清；提到 #6B7280（约 4.8:1）。真正装饰性的浅灰用 LineSoft。 -->
  <SolidColorBrush x:Key="Ink3" Color="#6B7280" />
  <SolidColorBrush x:Key="Ink4" Color="#9CA3AF" />
  <SolidColorBrush x:Key="Line" Color="#E5E7EB" />
  <SolidColorBrush x:Key="LineSoft" Color="#F1F3F5" />
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Canvas" Color="#F6F7F9" />
  <SolidColorBrush x:Key="Ok" Color="#15803D" />
  <SolidColorBrush x:Key="OkSoft" Color="#ECFDF3" />
  <SolidColorBrush x:Key="Warn" Color="#B45309" />
  <SolidColorBrush x:Key="WarnSoft" Color="#FFF7ED" />
  <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
  <SolidColorBrush x:Key="DangerSoft" Color="#FEF2F2" />

  <!-- Fluent 的强调色由这几个键派生：开关、勾选框、焦点框、选中高亮都在用。
       不改它们就会和我们的 #2563EB 并成"两套蓝"。 -->
  <Color x:Key="SystemAccentColor">#2563EB</Color>
  <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
  <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
  <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>
  <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
  <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
  <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>

  <FontFamily x:Key="MonoFont">Consolas,Cascadia Mono,Menlo,monospace</FontFamily>
</ResourceDictionary>
